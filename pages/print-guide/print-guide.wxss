.guide-page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 64rpx; background: #f6f0e2; color: #493c31; }
.guide-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 12rpx 4rpx 34rpx; }.eyebrow { color: #9e603d; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.page-title { font-size: 42rpx; font-weight: 600; }.page-subtitle { color: #827567; font-size: 24rpx; }
.notice { display: flex; gap: 18rpx; padding: 24rpx; border-radius: 14rpx; background: #e7eee5; }.notice-main { margin-bottom: 32rpx; }.notice-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 78rpx; height: 78rpx; border: 4rpx solid #246346; border-radius: 50%; color: #246346; font-size: 22rpx; font-weight: 700; }.notice-copy { display: flex; flex-direction: column; gap: 8rpx; }.notice-title { font-size: 28rpx; font-weight: 600; }.notice-text { color: #6f5d4e; font-size: 23rpx; line-height: 1.55; }
.section-block { margin-bottom: 28rpx; padding: 24rpx; border: 2rpx solid #f0dfd0; border-radius: 14rpx; background: #fffefa; }.section-title { display: block; margin-bottom: 20rpx; font-size: 29rpx; font-weight: 600; }.check-row { display: flex; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #f1e8dc; }.check-row:first-of-type { border-top: 0; }.step-number { flex: 0 0 48rpx; color: #b96f50; font-size: 20rpx; font-weight: 700; }.row-title { display: block; font-size: 25rpx; font-weight: 600; }.row-note { display: block; margin-top: 6rpx; color: #827567; font-size: 22rpx; line-height: 1.5; }.join-flow { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 10rpx 0 20rpx; }.join-page { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 76rpx; border: 3rpx solid #246346; border-radius: 5rpx; background: #f9ecd9; color: #246346; font-size: 24rpx; font-weight: 600; }.join-line { color: #b96f50; font-size: 28rpx; }.section-note { color: #827567; font-size: 22rpx; line-height: 1.55; }.bullet-row { display: flex; gap: 12rpx; padding: 10rpx 0; color: #6f5d4e; font-size: 23rpx; line-height: 1.5; }.bullet { color: #df7650; font-size: 28rpx; }.tip-box { display: flex; flex-direction: column; gap: 8rpx; padding: 22rpx 24rpx; border-left: 6rpx solid #e5a34a; background: #fff8ed; }.tip-title { color: #9e603d; font-size: 25rpx; font-weight: 600; }.tip-text { color: #6f5d4e; font-size: 22rpx; line-height: 1.55; }
@media (max-width: 360px) { .guide-page { padding-right: 24rpx; padding-left: 24rpx; } }
