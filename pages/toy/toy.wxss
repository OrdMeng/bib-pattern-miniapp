.toy-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f6f0e2;
  color: #493c31;
}

.toy-heading { margin: 12rpx 4rpx 32rpx; }
.toy-title { font-size: 38rpx; font-weight: 600; }
.category-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.category-card { box-sizing: border-box; min-width: 0; margin: 0; padding: 18rpx; border: 2rpx solid #f0dfd0; border-radius: 16rpx; background: #fffefa; color: #493c31; text-align: left; }
.category-card::after { border: 0; }
.category-art { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; border-radius: 12rpx; background: #f3e4d5; }
.carrot-art { overflow: hidden; background: #f7f7f2; }
.category-photo { display: block; width: 100%; height: 100%; }
.apple-art { position: relative; }
.apple-art { overflow: hidden; background: #f7f7f2; }
.frog-art { overflow: hidden; background: #d9d2be; }
.category-photo { display: block; width: 100%; height: 100%; }
.persimmon-art { overflow: hidden; background: #f5f3ef; }
.sheep-art { overflow: hidden; background: #dce8e9; }
.hippo-art { overflow: hidden; background: #d7eeee; }
.owl-art { overflow: hidden; background: #ece5dc; }
.elephant-art { position: relative; overflow: hidden; background: #f0e6d9; }
.elephant-art::after { position: absolute; right: 12%; bottom: 12%; left: 12%; height: 10%; border-radius: 50%; background: rgba(73, 60, 49, .08); content: ""; }
.elephant-icon { position: absolute; z-index: 1; bottom: 25%; width: 29%; height: 33%; border: 3rpx solid #246346; border-radius: 49% 49% 38% 38%; background: #d6a3a1; box-shadow: inset -5rpx -5rpx 0 rgba(73, 60, 49, .08); }
.elephant-child { left: 24%; transform: scale(.82); }
.elephant-parent { right: 23%; background: #8fb8bb; }
.elephant-ear { position: absolute; top: 18%; width: 35%; height: 39%; border: 3rpx solid #246346; border-radius: 50%; background: #e5a34a; box-shadow: inset 3rpx 3rpx 0 rgba(255, 250, 244, .35); }
.elephant-child .elephant-ear { left: -21%; transform: rotate(-28deg); }
.elephant-parent .elephant-ear { right: -21%; transform: rotate(28deg); }
.elephant-eye { position: absolute; top: 36%; right: 27%; width: 7rpx; height: 7rpx; border-radius: 50%; background: #493c31; }
.elephant-trunk { position: absolute; bottom: -20%; left: 42%; width: 24%; height: 39%; border: 3rpx solid #246346; border-top: 0; border-radius: 0 0 50% 50%; background: inherit; }
.elephant-foot { position: absolute; bottom: -12%; width: 24%; height: 21%; border: 3rpx solid #246346; border-radius: 0 0 38% 38%; background: inherit; }
.elephant-foot-left { left: 17%; }
.elephant-foot-right { right: 17%; }
.deer-art { overflow: hidden; background: #f6eee5; }
.polar-bear-art { overflow: hidden; background: #e9e9e6; }
.category-footer { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 18rpx 2rpx 4rpx; }
.category-name { font-size: 30rpx; font-weight: 600; }
.category-arrow { color: #9e603d; font-size: 44rpx; line-height: 1; }

@media (max-width: 360px) {
  .toy-page { padding-right: 24rpx; padding-left: 24rpx; }
  .category-grid { gap: 14rpx; }
  .category-card { padding: 14rpx; }
}
