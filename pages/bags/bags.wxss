.bags-page { box-sizing: border-box; height: 100vh; background: #f6f0e2; }
.bags-shell { box-sizing: border-box; padding: 48rpx 32rpx; color: #493c31; }
.bags-heading { margin: 12rpx 4rpx 32rpx; }
.bags-title { font-size: 38rpx; font-weight: 600; }
.guide-entry { display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 104rpx; margin: 0 0 24rpx; padding: 16rpx 18rpx; border: 2rpx solid #f0dfd0; border-radius: 16rpx; background: #fffefa; color: #493c31; text-align: left; }
.guide-entry::after { border: 0; }
.guide-entry-icon { position: relative; flex: 0 0 66rpx; width: 66rpx; height: 66rpx; border: 4rpx solid #246346; border-radius: 8rpx; background: #fff8ed; }
.guide-entry-line { position: absolute; left: 18rpx; width: 30rpx; height: 3rpx; border-radius: 2rpx; background: #b96f50; }
.guide-entry-line-one { top: 18rpx; }
.guide-entry-line-two { top: 31rpx; }
.guide-entry-line-three { top: 44rpx; }
.guide-entry-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; min-width: 0; }
.guide-entry-title { font-size: 26rpx; font-weight: 600; }
.guide-entry-note { color: #827567; font-size: 21rpx; line-height: 1.4; }
.bag-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.bag-item { box-sizing: border-box; min-width: 0; margin: 0; padding: 18rpx; border: 2rpx solid #f0dfd0; border-radius: 16rpx; background: #fffefa; color: #493c31; text-align: left; }
.bag-item::after { border: 0; }
.bag-art { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; overflow: hidden; border-radius: 12rpx; background: #f3e4d5; }
.bag-image { display: block; width: 100%; height: 100%; }
.bag-index { position: absolute; top: 10rpx; left: 10rpx; padding: 3rpx 8rpx; border-radius: 8rpx; background: rgba(73, 60, 49, 0.72); color: #fffefa; font-size: 19rpx; font-variant-numeric: tabular-nums; }
.bag-footer { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 18rpx 2rpx 4rpx; }
.bag-name { font-size: 28rpx; font-weight: 600; }
.bag-arrow { color: #9e603d; font-size: 44rpx; line-height: 1; }
@media (max-width: 360px) {
  .bags-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .bag-grid { gap: 12rpx; }
  .bag-item { padding: 14rpx; }
  .bag-name { font-size: 25rpx; }
  .guide-entry-note { font-size: 20rpx; }
}
