.baby-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f6f0e2;
  color: #493c31;
}

.baby-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 12rpx 4rpx 32rpx;
}

.baby-title { font-size: 38rpx; font-weight: 600; }
.baby-subtitle { color: #827567; font-size: 24rpx; }
.baby-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }

.baby-card {
  box-sizing: border-box;
  width: 100% !important;
  min-width: 0;
  margin: 0;
  padding: 18rpx;
  border: 2rpx solid #f0dfd0;
  border-radius: 12rpx;
  background: #fffefa;
  color: #493c31;
  text-align: left;
}

.baby-card::after { border: 0; }
.baby-card-art { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; overflow: hidden; border-radius: 10rpx; }
.bib-art { background: #f3e4d5; }
.bib-shape { position: relative; width: 58%; height: 58%; border: 4rpx solid #b96f50; border-radius: 28% 28% 44% 44%; background: #fff8ed; transform: perspective(200rpx) rotateX(-4deg); }
.bib-neck { position: absolute; top: -4rpx; left: 50%; width: 38%; height: 30%; border: 4rpx solid #b96f50; border-top: 0; border-radius: 0 0 50% 50%; background: #f3e4d5; transform: translateX(-50%); }
.sunhat-art { background: #e8e6d8; }
.vest-art { background: #f2e6d9; }
.bee-vest-art { background: #f4eee1; }
.baby-card-photo { display: block; width: 100%; height: 100%; }
.baby-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 18rpx 2rpx 4rpx; }
.baby-card-name { font-size: 30rpx; font-weight: 600; }
.baby-card-arrow { color: #9e603d; font-size: 44rpx; line-height: 1; }

@media (max-width: 360px) {
  .baby-page { padding-right: 24rpx; padding-left: 24rpx; }
  .baby-grid { gap: 14rpx; }
  .baby-card { padding: 14rpx; }
}
