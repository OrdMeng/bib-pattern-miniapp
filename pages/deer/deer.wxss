.deer-page { box-sizing: border-box; height: 100vh; background: #f6f0e2; }
.deer-shell { box-sizing: border-box; padding: 36rpx 32rpx 64rpx; color: #493c31; }
.deer-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 0 4rpx 22rpx; }
.deer-title { font-size: 38rpx; font-weight: 600; }
.deer-subtitle { color: #827567; font-size: 24rpx; }
.deer-cover { display: block; width: 100%; margin-bottom: 34rpx; background: #fffefa; }
.deer-section { display: flex; flex-direction: column; gap: 6rpx; margin: 0 4rpx 16rpx; }
.section-title { font-size: 29rpx; font-weight: 600; }
.section-note { color: #827567; font-size: 22rpx; line-height: 1.5; }
.deer-instruction-image { display: block; width: 100%; margin-bottom: 24rpx; background: #fffefa; }
.deer-pattern-info { margin-bottom: 36rpx; padding: 20rpx; background: #fffefa; }
.pattern-note { display: block; color: #827567; font-size: 23rpx; line-height: 1.55; }
.pattern-button { display: flex; align-items: center; justify-content: center; height: 82rpx; margin: 20rpx 0 0; padding: 0; border: 0; border-radius: 10rpx; background: #246346; color: #fffefa; font-size: 27rpx; line-height: normal; }
.pattern-button::after { border: 0; }
.process-heading { margin-top: 4rpx; }
.deer-finished { display: block; width: 100%; margin-top: 10rpx; background: #fffefa; }
@media (max-width: 360px) {
  .deer-shell { padding-right: 24rpx; padding-left: 24rpx; }
}
