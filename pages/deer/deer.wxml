<scroll-view class="deer-page" scroll-y>
  <view class="deer-shell">
    <view class="deer-heading">
      <text class="deer-title">小情侣小鹿</text>
      <text class="deer-subtitle">布艺玩偶 · 纸样与制作过程</text>
    </view>

    <image
      class="deer-cover"
      src="/assets/deer-cover.jpg"
      mode="widthFix"
      bindtap="previewImage"
      data-src="/assets/deer-cover.jpg"
      aria-label="红蓝格子布小情侣小鹿成品参考图"
    />

    <view class="deer-section">
      <text class="section-title">小鹿纸样</text>
      <text class="section-note">身体左右对称各一片，另有头部、耳朵、鹿角和尾巴裁片；点击图片可放大查看。</text>
    </view>
    <image
      class="deer-instruction-image"
      src="/assets/deer-pattern.png"
      mode="widthFix"
      bindtap="previewImage"
      data-src="/assets/deer-pattern.png"
      aria-label="小鹿纸样图"
    />

    <view class="deer-pattern-info">
      <text class="pattern-note">裁剪时按纸样标注的数量准备布片，身体裁片需要左右对称；开口处用于翻面和填充。</text>
      <button class="pattern-button" bindtap="openPattern">打开小鹿纸样 PDF</button>
    </view>

    <view class="deer-section process-heading">
      <text class="section-title">制作过程</text>
      <text class="section-note">先缝合头部和身体，再填充、翻口并完成组合。</text>
    </view>
    <image
      class="deer-instruction-image"
      src="/assets/deer-tutorial.jpg"
      mode="widthFix"
      bindtap="previewImage"
      data-src="/assets/deer-tutorial.jpg"
      aria-label="小鹿制作教程图"
    />

    <image
      class="deer-finished"
      src="/assets/deer-finished-2.jpg"
      mode="widthFix"
      bindtap="previewImage"
      data-src="/assets/deer-finished-2.jpg"
      aria-label="小情侣小鹿侧面成品参考图"
    />
  </view>
</scroll-view>
