.pattern-page { box-sizing: border-box; height: 100vh; background: #f6f0e2; }
.pattern-shell { box-sizing: border-box; padding: 36rpx 32rpx 64rpx; color: #493c31; }
.pattern-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 0 4rpx 22rpx; }
.pattern-title { font-size: 38rpx; font-weight: 600; }
.pattern-subtitle { color: #827567; font-size: 24rpx; line-height: 1.45; }
.pattern-cover { display: block; width: 100%; margin-bottom: 28rpx; background: #fffefa; }
.pattern-section { padding: 20rpx; background: #fffefa; }
.intro-section { margin-bottom: 34rpx; }
.section-title { display: block; margin-bottom: 8rpx; font-size: 29rpx; font-weight: 600; }
.section-note { color: #827567; font-size: 22rpx; line-height: 1.55; }
.preview-section { margin-bottom: 24rpx; }
.pattern-image { display: block; width: 100%; margin-top: 16rpx; background: #fff; }
.download-button { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 82rpx; margin: 0; padding: 0; border: 0; border-radius: 10rpx; background: #246346; color: #fffefa; font-size: 27rpx; line-height: normal; }
.download-button::after { border: 0; }
@media (max-width: 360px) {
  .pattern-shell { padding-right: 24rpx; padding-left: 24rpx; }
}
