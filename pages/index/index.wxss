.page {
  min-height: 100vh;
  background: #f6f0e2;
}

.app-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 16rpx 28rpx 48rpx;
  color: #493c31;
}

.header {
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: 20rpx;
}

.title-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.title { font-size: 38rpx; font-weight: 500; }
.subtitle { color: #827567; font-size: 24rpx; }

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  border: 1rpx solid transparent;
  border-radius: 50%;
  background: transparent;
  color: #493c31;
  font-size: 52rpx;
  line-height: 1;
}

.icon-button.more {
  border-color: #e5d9c5;
  background: #fffefa;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  padding-bottom: 16rpx;
}

.section-label { margin-bottom: 12rpx; color: #827567; font-size: 24rpx; }

.style-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.style-button {
  box-sizing: border-box;
  flex: 0 0 calc(50% - 6rpx);
  min-width: 0;
  min-height: 84rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #e5d9c5;
  border-radius: 14rpx;
  background: #f1e2d2;
  color: #9e603d;
  font-size: 26rpx;
  line-height: 84rpx;
}

.style-button.active { background: #9e603d; color: #fffaf4; border-color: #9e603d; }

.paper-panel {
  padding: 18rpx 16rpx 12rpx;
  border: 1rpx solid #e5d9c5;
  border-radius: 16rpx;
  background: #fffefa;
}

.paper-caption { display: flex; justify-content: space-between; gap: 12rpx; min-height: 36rpx; }
.kind-label { font-size: 26rpx; font-weight: 500; }
.proof { color: #827567; font-size: 22rpx; }

.pattern-canvas { display: block; width: 100%; height: 760rpx; }
.canvas-description { position: absolute; width: 1rpx; height: 1rpx; overflow: hidden; opacity: 0; }

.readout { min-height: 72rpx; padding: 18rpx 0 6rpx; color: #827567; text-align: center; font-size: 25rpx; }

.controls-section,
.shared-section { padding: 0 4rpx; }

.field { padding: 22rpx 0; border-bottom: 1rpx solid #e5d9c5; }
.field-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #493c31; font-size: 27rpx; }
.field-value { color: #9e603d; font-variant-numeric: tabular-nums; }
.field slider { display: block; margin: 18rpx 0 4rpx; }
.limits { display: flex; justify-content: space-between; color: #827567; font-size: 22rpx; }

.shared-section { padding-top: 24rpx; }
.neck-input { box-sizing: border-box; width: 100%; height: 78rpx; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid #d8c8b3; border-radius: 12rpx; background: #fffefa; color: #493c31; font-size: 30rpx; }
.seam-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e5d9c5; }
.seam-row > view { display: flex; flex-direction: column; gap: 6rpx; }
.seam-title { font-size: 28rpx; }
.seam-note { color: #827567; font-size: 22rpx; }

.feedback { margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #f1e2d2; color: #9e603d; font-size: 24rpx; line-height: 1.5; }
.feedback.error { background: #f7e0dc; color: #a23d36; }

.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 28rpx; }
.action-button { height: 84rpx; border-radius: 14rpx; font-size: 28rpx; line-height: 84rpx; }
.action-button.print { border: 1rpx solid #9e603d; background: #9e603d; color: #fffaf4; }
.action-button.save { border: 1rpx solid #246346; background: #246346; color: #fffefa; }
.action-button[disabled] { opacity: 0.45; }

@media (max-width: 360px) {
  .app-shell { padding-left: 20rpx; padding-right: 20rpx; }
  .style-button { font-size: 23rpx; }
  .pattern-canvas { height: 680rpx; }
}
