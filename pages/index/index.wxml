<scroll-view class="pattern-page" scroll-y>
  <view class="pattern-shell">
    <view class="pattern-heading">
      <text class="pattern-title">{{title}}</text>
      <text class="pattern-subtitle">{{subtitle}}</text>
    </view>

    <image
      class="pattern-cover"
      src="{{coverImage}}"
      mode="widthFix"
      bindtap="previewImage"
      data-src="{{coverImage}}"
      aria-label="{{title}}成品参考图"
    />

    <view class="pattern-section intro-section">
      <text class="section-title">纸样说明</text>
      <text class="section-note">{{note}}</text>
    </view>

    <view class="pattern-section preview-section">
      <text class="section-title">纸样预览</text>
      <image
        class="pattern-image"
        src="{{patternImage}}"
        mode="widthFix"
        bindtap="previewImage"
        data-src="{{patternImage}}"
        aria-label="{{title}}纸样预览"
      />
    </view>

    <button class="download-button" bindtap="downloadPattern">下载纸样</button>
  </view>
</scroll-view>
