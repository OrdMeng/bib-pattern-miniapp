<scroll-view class="page" scroll-y enable-flex>
  <view class="app-shell">
    <view class="header">
      <view aria-hidden="true"></view>
      <view class="title-group">
        <text class="title">{{isPersimmon ? '柿子纸样' : isFrog ? '小青蛙纸样' : isApple ? '苹果纸样' : isCarrot ? '胡萝卜纸样' : kind === 'petal' ? '花瓣口水巾 · 纸样' : '口水巾 · 纸样生成'}}</text>
        <text class="subtitle">{{isPersimmon ? '果实 4片 · 叶子 8片 · 果蒂 1片' : isFrog ? '头 · 身体 · 眼皮 · 眼球 · 胳膊 · 背带裤' : isApple ? '苹果片 6片 · 叶子 2片' : isCarrot ? '主体 1片 · 叶片 6片' : kind === 'petal' ? '成品参考 · 参数调整后即时更新' : '参数调整后即时更新'}}</text>
      </view>
      <button class="icon-button more" aria-label="更多" bindtap="handleMore">···</button>
    </view>

    <view wx:if="{{!isCarrot && !isApple && !isFrog && !isPersimmon}}" class="section-label">纸样款式</view>
    <view wx:if="{{!isCarrot && !isApple && !isFrog && !isPersimmon}}" class="style-picker" role="group" aria-label="纸样款式">
      <button wx:for="{{styles}}" wx:key="id" class="style-button {{item.id === kind ? 'active' : ''}}" data-kind="{{item.id}}" aria-pressed="{{item.id === kind}}" bindtap="selectKind">{{item.label}}</button>
    </view>

    <view class="paper-panel">
      <view class="paper-caption">
        <text class="kind-label">{{kindLabel}}</text>
        <text class="proof">{{isCarrot || isApple || isFrog || isPersimmon ? '原图纸样' : '示意轮廓 · 待样片验证'}}</text>
      </view>
      <canvas id="patternCanvas" type="2d" class="pattern-canvas" aria-label="{{canvasDescription}}"></canvas>
      <view class="canvas-description" aria-live="polite">{{canvasDescription}}</view>
    </view>

    <view class="readout" aria-live="polite">{{readout}}</view>

    <view class="controls-section" aria-label="纸样参数">
      <view wx:if="{{kind === 'bib' || kind === 'petal'}}" class="field">
        <view class="field-head"><text>{{paramsConfig.length.label}} (cm)</text><text class="field-value">{{length}}cm</text></view>
        <slider min="4" max="30" step="0.5" value="{{length}}" data-key="length" show-value="false" activeColor="#9e603d" backgroundColor="#d9cfc0" bindchange="changeSlider" aria-label="围兜长度"></slider>
        <view class="limits"><text>4cm</text><text>30cm</text></view>
      </view>

      <view wx:if="{{kind !== 'triangle' && !isCarrot && !isApple && !isFrog && !isPersimmon}}" class="field">
        <view class="field-head"><text>围兜宽度 (cm)</text><text class="field-value">{{width}}cm</text></view>
        <slider min="{{kind === 'o' ? 3 : 2}}" max="{{kind === 'o' ? 10 : 18}}" step="0.5" value="{{width}}" data-key="width" activeColor="#9e603d" backgroundColor="#d9cfc0" bindchange="changeSlider" aria-label="围兜宽度"></slider>
        <view class="limits"><text>{{kind === 'o' ? '3cm' : '2cm'}}</text><text>{{kind === 'o' ? '10cm' : '18cm'}}</text></view>
      </view>

      <view wx:if="{{kind === 'petal' || kind === 'o'}}" class="field">
        <view class="field-head"><text>花瓣总数 (个)</text><text class="field-value">{{count}}个</text></view>
        <slider min="0" max="{{kind === 'o' ? 16 : 8}}" step="1" value="{{count}}" data-key="count" activeColor="#9e603d" backgroundColor="#d9cfc0" bindchange="changeSlider" aria-label="花瓣总数"></slider>
        <view class="limits"><text>0个</text><text>{{kind === 'o' ? '16个' : '8个'}}</text></view>
      </view>

      <view wx:if="{{kind === 'petal' || kind === 'o'}}" class="field">
        <view class="field-head"><text>花瓣大小 (cm)</text><text class="field-value">{{size}}cm</text></view>
        <slider min="1.2" max="4" step="0.1" value="{{size}}" data-key="size" activeColor="#9e603d" backgroundColor="#d9cfc0" bindchange="changeSlider" aria-label="花瓣大小"></slider>
        <view class="limits"><text>1.2cm</text><text>4cm</text></view>
      </view>

      <view wx:if="{{kind === 'o'}}" class="field">
        <view class="field-head"><text>搭片交叠量 (cm)</text><text class="field-value">{{overlap}}cm</text></view>
        <slider min="2" max="3" step="0.5" value="{{overlap}}" data-key="overlap" activeColor="#9e603d" backgroundColor="#d9cfc0" bindchange="changeSlider" aria-label="搭片交叠量"></slider>
        <view class="limits"><text>2cm</text><text>3cm</text></view>
      </view>
    </view>

    <view wx:if="{{!isCarrot}}" class="shared-section" aria-label="通用参数">
      <block wx:if="{{!isCarrot && !isApple && !isFrog && !isPersimmon}}">
        <view class="field-head"><text>脖围 (厘米)</text><text class="field-value">{{neck}}cm</text></view>
        <input class="neck-input" type="digit" value="{{neck}}" maxlength="4" placeholder="20-50" bindblur="changeNeck" aria-label="脖围，20到50厘米，步进0.5厘米" />
      </block>
      <view wx:if="{{!isCarrot}}" class="seam-row">
        <view><text class="seam-title">{{isApple || isFrog || isPersimmon ? '原图纸样' : '显示缝份'}}</text><text class="seam-note">{{isApple || isFrog || isPersimmon ? '图片自带线条 · 打印前请按A4 100%比例输出' : '固定 1cm · 灰色虚线'}}</text></view>
        <switch wx:if="{{!isApple && !isFrog && !isPersimmon}}" checked="{{seam}}" color="#9e603d" bindchange="toggleSeam" aria-label="显示缝份"></switch>
      </view>
    </view>

    <view wx:if="{{feedback}}" class="feedback {{feedbackType === 'error' ? 'error' : ''}}" role="alert">{{feedback}}</view>

    <view class="actions">
      <button class="action-button print" bindtap="handlePrint" disabled="{{!patternValid || isExporting}}">{{isExporting ? '生成中...' : '纸样打印'}}</button>
      <button class="action-button save" bindtap="handleSave" disabled="{{!patternValid || isExporting}}">{{isExporting ? '保存中...' : '保存图片'}}</button>
    </view>
  </view>
</scroll-view>
