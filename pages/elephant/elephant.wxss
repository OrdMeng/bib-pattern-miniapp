.elephant-page { box-sizing: border-box; height: 100vh; background: #f6f0e2; }
.elephant-shell { box-sizing: border-box; padding: 36rpx 32rpx 64rpx; color: #493c31; }
.elephant-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 0 4rpx 22rpx; }
.elephant-title { font-size: 38rpx; font-weight: 600; }
.elephant-subtitle { color: #827567; font-size: 24rpx; }
.elephant-hero { display: flex; align-items: center; justify-content: center; height: 600rpx; margin-bottom: 22rpx; overflow: hidden; border-radius: 16rpx; background: #eadfce; }
.elephant-hero-image { display: block; width: 100%; height: 100%; }
.elephant-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rpx; margin-bottom: 34rpx; background: #e5d9c5; }
.fact { display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx 10rpx; background: #fffefa; text-align: center; }
.fact-label { color: #827567; font-size: 21rpx; }
.fact-value { color: #9e603d; font-size: 25rpx; font-weight: 600; }
.section-heading { display: flex; flex-direction: column; gap: 6rpx; margin: 0 4rpx 16rpx; }
.section-title { font-size: 29rpx; font-weight: 600; }
.section-note { color: #827567; font-size: 22rpx; line-height: 1.5; }
.pattern-info { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; background: #fffefa; }
.pattern-title { font-size: 27rpx; font-weight: 600; }
.pattern-note { color: #827567; font-size: 23rpx; line-height: 1.55; }
.pattern-button { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 82rpx; margin: 20rpx 0 0; padding: 0; border: 0; border-radius: 10rpx; background: #246346; color: #fffefa; font-size: 27rpx; line-height: normal; }
.pattern-button::after { border: 0; }

@media (max-width: 360px) {
  .elephant-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .fact { padding-right: 6rpx; padding-left: 6rpx; }
  .fact-value { font-size: 23rpx; }
}
