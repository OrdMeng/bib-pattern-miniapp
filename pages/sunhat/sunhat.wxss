.sunhat-page {
  box-sizing: border-box;
  height: 100vh;
  background: #f6f0e2;
}

.sunhat-shell {
  box-sizing: border-box;
  padding: 36rpx 32rpx 64rpx;
  color: #493c31;
}

.sunhat-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 4rpx 22rpx;
}

.sunhat-title { font-size: 38rpx; font-weight: 600; }
.sunhat-subtitle { color: #827567; font-size: 24rpx; }

.finished-photo-wrap {
  display: flex;
  justify-content: center;
  height: 340rpx;
  margin-bottom: 34rpx;
  overflow: hidden;
  background: #ede8db;
}

.finished-photo { width: 100%; height: 100%; }

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 0 4rpx 16rpx;
}

.section-title { font-size: 29rpx; font-weight: 600; }
.section-note { color: #827567; font-size: 22rpx; }

.size-list {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-bottom: 18rpx;
}

.size-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  width: auto !important;
  height: 62rpx;
  border: 1rpx solid #e5d9c5;
  background: #fffefa;
  color: #9e603d;
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

.size-item::after { border: 0; }
.size-item.selected { border-color: #246346; background: #246346; color: #fffefa; }
.size-unit { color: #827567; font-size: 20rpx; }

.cutting-info {
  margin-bottom: 34rpx;
  padding: 0 18rpx 16rpx;
  background: #fffefa;
}

.cutting-row {
  display: flex;
  justify-content: space-between;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #eee5d8;
  font-size: 25rpx;
}

.cutting-row text:last-child { color: #9e603d; font-variant-numeric: tabular-nums; }
.print-note { display: block; padding-top: 15rpx; color: #827567; font-size: 22rpx; line-height: 1.5; }
.pattern-preview { margin-bottom: 36rpx; }
.pattern-preview .section-heading { margin-bottom: 14rpx; }
.pattern-image { display: block; width: 100%; border: 1rpx solid #e5d9c5; background: #fff; }
.pattern-button { display: flex; align-items: center; justify-content: center; width: 100% !important; height: 82rpx; margin: 18rpx 0 0; padding: 0; border: 0; border-radius: 10rpx; background: #246346; color: #fffefa; font-size: 27rpx; line-height: normal; }
.pattern-button::after { border: 0; }
.tutorial-heading { margin-bottom: 14rpx; }
.tutorial-image { display: block; width: 100%; }

@media (max-width: 360px) {
  .sunhat-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .size-list { gap: 4rpx; }
  .size-item { font-size: 21rpx; }
}
