<view class="home-page">
  <view class="home-heading">
    <text class="home-title">分类</text>
    <text class="home-subtitle">选择要制作的纸样</text>
  </view>

  <view class="category-grid">
    <button class="category-card" data-category="baby" bindtap="openCategory" aria-label="宝宝衣物，0到1岁手作纸样">
      <view class="category-art baby-art" aria-hidden="true">
        <view class="baby-vest-icon baby-vest-back"></view>
        <view class="baby-vest-icon baby-vest-front">
          <view class="baby-vest-neck"></view>
          <view class="baby-vest-placket"></view>
          <view class="baby-vest-button baby-vest-button-one"></view>
          <view class="baby-vest-button baby-vest-button-two"></view>
          <view class="baby-vest-button baby-vest-button-three"></view>
        </view>
      </view>
      <view class="category-footer">
        <text class="category-name">宝宝衣物</text>
        <text class="category-arrow" aria-hidden="true">›</text>
      </view>
    </button>

    <button class="category-card" data-category="toy" bindtap="openCategory" aria-label="玩具分类">
      <view class="category-art toy-art" aria-hidden="true">
        <view class="toy-block toy-block-top"></view>
        <view class="toy-block toy-block-left"></view>
        <view class="toy-block toy-block-right"></view>
      </view>
      <view class="category-footer">
        <text class="category-name">玩具</text>
        <text class="category-arrow" aria-hidden="true">›</text>
      </view>
    </button>

    <button class="category-card" data-category="bags" bindtap="openCategory" aria-label="包包分类，包含210款包包参考图">
      <view class="category-art bags-art" aria-hidden="true">
        <view class="bag-icon">
          <view class="bag-handle"></view>
          <view class="bag-body">
            <view class="bag-pocket"></view>
            <view class="bag-stitch bag-stitch-one"></view>
            <view class="bag-stitch bag-stitch-two"></view>
          </view>
        </view>
      </view>
      <view class="category-footer">
        <text class="category-name">包包</text>
        <text class="category-arrow" aria-hidden="true">›</text>
      </view>
    </button>

    <button class="category-card toolbox-card" data-category="toolbox" bindtap="openCategory" aria-label="缝纫工具箱">
      <view class="category-art toolbox-art" aria-hidden="true">
        <view class="toolbox-handle"></view>
        <view class="toolbox-case"></view>
        <view class="toolbox-lid"></view>
        <view class="toolbox-latch"></view>
        <view class="toolbox-stitch toolbox-stitch-one"></view>
        <view class="toolbox-stitch toolbox-stitch-two"></view>
      </view>
      <view class="category-footer">
        <text class="category-name">缝纫工具箱</text>
        <text class="category-arrow" aria-hidden="true">›</text>
      </view>
    </button>

  </view>
</view>
