.trouble-page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 64rpx; background: #f6f0e2; color: #493c31; }.trouble-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 12rpx 4rpx 30rpx; }.eyebrow { color: #9e603d; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.page-title { font-size: 42rpx; font-weight: 600; }.page-subtitle { color: #827567; font-size: 24rpx; }.search-box { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; padding: 0 20rpx; border: 2rpx solid #f0dfd0; border-radius: 12rpx; background: #fffefa; }.search-symbol { color: #9e603d; font-size: 38rpx; }.search-box input { flex: 1; height: 82rpx; color: #493c31; font-size: 24rpx; }.issue-list { overflow: hidden; border: 2rpx solid #f0dfd0; border-radius: 14rpx; background: #fffefa; }.issue-item + .issue-item { border-top: 1rpx solid #f1e8dc; }.issue-head { display: flex; align-items: center; width: 100%; min-height: 106rpx; margin: 0; padding: 18rpx 20rpx; border-radius: 0; background: transparent; color: #493c31; text-align: left; }.issue-head::after { border: 0; }.issue-index { display: flex; align-items: center; justify-content: center; flex: 0 0 44rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #f3e4d5; color: #b96f50; font-size: 20rpx; font-weight: 700; }.issue-summary { display: flex; flex: 1; flex-direction: column; gap: 4rpx; margin-left: 16rpx; }.issue-title { font-size: 26rpx; font-weight: 600; }.issue-tags { color: #a18d7e; font-size: 20rpx; }.issue-toggle { width: 40rpx; color: #9e603d; font-size: 34rpx; text-align: center; }.issue-detail { margin: -2rpx 20rpx 22rpx 80rpx; padding: 18rpx 20rpx; border-left: 4rpx solid #e5a34a; background: #fff8ed; }.detail-row + .detail-row { margin-top: 14rpx; }.detail-label { display: block; color: #9e603d; font-size: 21rpx; font-weight: 600; }.detail-copy { display: block; margin-top: 4rpx; color: #6f5d4e; font-size: 22rpx; line-height: 1.55; }.empty-state { padding: 64rpx 20rpx; color: #827567; font-size: 23rpx; text-align: center; }
@media (max-width: 360px) { .trouble-page { padding-right: 24rpx; padding-left: 24rpx; } }
.issue-head { width: 100% !important; }
.expand-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; height: 44rpx; color: #9e603d; font-size: 32rpx; font-weight: 600; line-height: 44rpx; text-align: center; }
