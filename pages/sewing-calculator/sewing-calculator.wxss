.calculator-page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 64rpx; background: #f6f0e2; color: #493c31; }.calculator-heading { display: flex; flex-direction: column; gap: 8rpx; margin: 12rpx 4rpx 30rpx; }.eyebrow { color: #9e603d; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.page-title { font-size: 42rpx; font-weight: 600; }.page-subtitle { color: #827567; font-size: 24rpx; }.calculator-tabs { display: flex; gap: 10rpx; margin-bottom: 24rpx; }.calc-tab { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; margin: 0; padding: 16rpx 8rpx; border: 2rpx solid #f0dfd0; border-radius: 10rpx; background: #fffefa; color: #827567; font-size: 22rpx; line-height: normal; }.calc-tab::after { border: 0; }.calc-tab.active { border-color: #246346; background: #e7eee5; color: #246346; font-weight: 600; }.calculator-panel { padding: 26rpx 24rpx 24rpx; border: 2rpx solid #f0dfd0; border-radius: 14rpx; background: #fffefa; }.calc-title { display: block; font-size: 30rpx; font-weight: 600; }.calc-description { display: block; margin-top: 8rpx; color: #827567; font-size: 22rpx; line-height: 1.5; }.field-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; }.field-label { color: #6f5d4e; font-size: 24rpx; }.field-control { display: flex; align-items: center; width: 260rpx; height: 72rpx; padding: 0 18rpx; border: 2rpx solid #ead7c4; border-radius: 9rpx; background: #fff8ed; }.field-control input { flex: 1; min-width: 0; color: #493c31; font-size: 24rpx; }.field-control text { color: #9e603d; font-size: 22rpx; }.calculate-button { display: flex; align-items: center; justify-content: center; height: 82rpx; margin: 28rpx 0 24rpx; padding: 0; border-radius: 10rpx; background: #246346; color: #fffefa; font-size: 26rpx; line-height: normal; }.calculate-button::after { border: 0; }.result-box { display: flex; align-items: center; justify-content: space-between; padding: 22rpx; border-radius: 10rpx; background: #e7eee5; }.result-label { color: #6f5d4e; font-size: 23rpx; }.result-number { color: #246346; font-size: 48rpx; font-weight: 700; }.result-unit { margin-left: 6rpx; color: #246346; font-size: 22rpx; }.formula-note { display: flex; flex-direction: column; gap: 8rpx; margin-top: 24rpx; padding: 22rpx 24rpx; border-left: 6rpx solid #e5a34a; background: #fff8ed; }.formula-title { color: #9e603d; font-size: 25rpx; font-weight: 600; }.formula-copy { color: #6f5d4e; font-size: 22rpx; line-height: 1.55; }
@media (max-width: 360px) { .calculator-page { padding-right: 24rpx; padding-left: 24rpx; }.field-control { width: 220rpx; } }
.calc-tab { width: auto !important; }
.calculate-button { width: 100% !important; }
